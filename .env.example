PORT=3000

# --- Google Drive access: recommended (OAuth as the school's real account) ---
# A Service Account (below) cannot create files in a regular (non-Workspace)
# Drive — it has no storage quota of its own. Instead, this app signs in as
# the school's actual Google account once, so uploads use its real quota.
# From Google Cloud Console → APIs & Services → Credentials → an OAuth
# client ID (type: Web application):
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on that OAuth client, and
# point at this deployed app, e.g. https://your-app.onrender.com/admin/google-auth/callback
GOOGLE_OAUTH_REDIRECT_URI=
# Leave empty until you complete the one-time setup: after the three vars
# above are set and deployed, visit /admin/google-auth/start in a browser
# signed into the school's Google account, approve access. The server stores the refresh token in DATA_DIR without
# displaying it. Keep an existing valid environment token if already configured.
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- Google Drive access: alternative (Service Account) ---
# Only works if GOOGLE_DRIVE_PARENT_FOLDER_ID below is a Shared Drive folder
# (Google Workspace only) — a Service Account has no quota on a personal Drive.
# Running locally: point at the downloaded key file.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json
# Deploying to a host, recommended over pasting raw JSON: base64-encode the
# key file into one unbroken line (see README) and paste that here.
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=
# Deploying to a host, alternative: paste the raw JSON content directly.
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=

# ID of the Google Drive folder under which dated sync folders are created.
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# Required in production: JSON object of authorized named users.
# Each entry has a password (at least 12 characters) and optional admin: true.
# Set real passwords only in Render's secure environment settings, never Git.
ACCESS_USERS_JSON=
# Use an EXISTING Render persistent disk mount (for example /var/data).
# DATA_DIR must be absolute in production. A free ephemeral disk is insufficient.
DATA_DIR=
# Production fails closed when access control or a persistent data path is missing.
NODE_ENV=development
