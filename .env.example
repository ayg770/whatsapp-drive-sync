PORT=3000

# Google service account credentials — set ONE of these two:
# - Running locally: point at the downloaded key file.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json
# - Deploying to a host (Render, Fly.io, etc.): paste the whole key file's
#   JSON content here instead (most hosts have no easy way to upload a file).
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=

# ID of the Google Drive folder (owned by the school account, shared with the
# service account's email as an Editor) under which dated sync folders are created.
GOOGLE_DRIVE_PARENT_FOLDER_ID=
