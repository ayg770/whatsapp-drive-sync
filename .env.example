PORT=3000

# Google service account credentials — set ONE of these:
# - Running locally: point at the downloaded key file.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json
# - Deploying to a host (Render, Fly.io, etc.), recommended: base64-encode the
#   key file into one unbroken line (see README) and paste that here. Safer
#   than pasting raw JSON, which a text editor can silently corrupt.
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=
# - Deploying to a host, alternative: paste the raw JSON content directly.
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=

# ID of the Google Drive folder (owned by the school account, shared with the
# service account's email as an Editor) under which dated sync folders are created.
GOOGLE_DRIVE_PARENT_FOLDER_ID=
